@namespace SolarUY.Presentation.Monitoreo
@using Radzen.Blazor
@using SolarUY.Application.Monitoreo
@implements IDisposable
@inject MonitoreoService Servicio
@inject ControlPanelService ControlPanel
@inject NotificacionMedicion Notificacion
@inject AuthenticationStateProvider Autenticacion
@inject ILogger<LecturaEnVivo> Logger

<section class="card mb-4" aria-labelledby="generacion-actual-titulo">
    <div class="card-body">
        <h2 id="generacion-actual-titulo" class="h5">Generación actual</h2>
        @if (_lectura is { } lectura)
        {
            <div class="lectura-principal">
                <div>
                    <div aria-live="polite">
                        @if (lectura.GeneracionActualW is { } valor)
                        {
                            <p class="lectura-valor">@FormatoSolar.Vatios(valor) <span>W</span></p>
                        }
                        else
                        {
                            <p class="fs-4 fw-semibold mb-2">No disponible</p>
                        }
                    </div>
                    <p class="text-body-secondary small mb-0">
                        @if (lectura.FechaUtc is { } fecha)
                        {
                            <span>Última medición · @FormatoSolar.FechaUruguay(fecha)</span>
                        }
                        else
                        {
                            <span>Aún no hay mediciones</span>
                        }
                    </p>
                </div>
                @if (lectura.GeneracionActualW is { } potencia)
                {
                    var maximo = MaximoEscala(lectura.PotenciaNominalW, potencia);
                    <div class="lectura-medidor" aria-hidden="true">
                        <RadzenRadialGauge Style="width: 100%; height: clamp(10rem, 22vw, 14rem);">
                            <RadzenRadialGaugeScale Min="0" Max="@maximo" Step="@(maximo / 4)" Formatter="@FormatoSolar.Vatios">
                                <RadzenRadialGaugeScalePointer Value="@potencia" Fill="var(--bs-primary)" />
                            </RadzenRadialGaugeScale>
                        </RadzenRadialGauge>
                    </div>
                }
            </div>

            <dl class="lectura-estados">
                <div>
                    <dt>Estado de control</dt>
                    <dd>@lectura.EstadoControl</dd>
                </div>
                <div>
                    <dt>Estado de la última medición</dt>
                    <dd>@(lectura.FechaUtc.HasValue ? lectura.Estado.ToString() : "Sin mediciones")</dd>
                </div>
            </dl>
            <AuthorizeView Roles="Administrador">
                <Authorized>
                    @if (lectura.PuedeCambiarEstado)
                    {
                        var activar = lectura.EstaDesactivado;
                        <button type="button" class="btn btn-outline-primary" disabled="@_enviandoOrden"
                                @onclick="() => CambiarEstadoAsync(activar)">
                            @(activar ? "Activar panel" : "Desactivar panel")
                        </button>
                    }
                    @if (_mensajeControl is not null)
                    {
                        <p class="mt-2 mb-0" role="@(_errorControl ? "alert" : "status")">@_mensajeControl</p>
                    }
                </Authorized>
            </AuthorizeView>
        }
        else
        {
            <p class="mb-0" role="status">@_mensaje</p>
        }
    </div>
</section>


@code {
    [Parameter] public Guid PanelId { get; set; }

    private LecturaPanelDto? _lectura;
    private IDisposable? _suscripcion;
    private bool _cerrado;
    private string? _mensajeControl;
    private bool _errorControl;
    private bool _enviandoOrden;
    private string _mensaje = "Cargando mediciones…";

    private static double MaximoEscala(float nominal, float lectura)
    {
        var referencia = float.IsFinite(nominal) && nominal > 0 ? nominal : 1;
        return Math.Max(referencia, lectura);
    }

    protected override async Task OnInitializedAsync()
    {
        var usuario = (await Autenticacion.GetAuthenticationStateAsync()).User;
        if (_cerrado)
            return;

        try
        {
            _suscripcion = Notificacion.Suscribir(usuario, PanelId, RecibirAsync);
            var lectura = await Servicio.ConsultarAsync(PanelId);
            if (!_cerrado && lectura is not null)
                Actualizar(lectura);
            else
                _mensaje = "No se encontró el panel.";
        }
        catch (UnauthorizedAccessException)
        {
            _mensaje = "Acceso denegado.";
        }
    }

    private Task RecibirAsync(LecturaPanelDto lectura) => InvokeAsync(() =>
    {
        if (!_cerrado)
        {
            Actualizar(lectura);
            StateHasChanged();
        }
    });

    private void Actualizar(LecturaPanelDto lectura)
    {
        if (lectura.PanelId == PanelId && (_lectura is null || lectura.EsPosteriorA(_lectura)))
            _lectura = lectura;
    }

    private async Task CambiarEstadoAsync(bool activar)
    {
        if (_enviandoOrden || _cerrado)
            return;

        _enviandoOrden = true;
        _mensajeControl = null;
        try
        {
            var usuario = (await Autenticacion.GetAuthenticationStateAsync()).User;
            var resultado = await ControlPanel.CambiarEstadoAsync(usuario, PanelId, activar);
            if (resultado.Lectura is { } confirmada)
                Actualizar(confirmada);

            _errorControl = resultado.Codigo is not (CodigoControlPanel.Actualizado or CodigoControlPanel.SinCambios);
            _mensajeControl = resultado.Codigo switch
            {
                CodigoControlPanel.Actualizado => activar ? "Panel activado." : "Panel desactivado.",
                CodigoControlPanel.SinCambios => "El panel ya estaba en el estado solicitado.",
                CodigoControlPanel.AccesoDenegado => "No tenés permiso para cambiar el estado del panel.",
                CodigoControlPanel.PanelNoEncontrado => "El panel ya no está disponible.",
                CodigoControlPanel.EstadoNoPermitido => "El estado actual del panel no permite esa acción.",
                _ => "No se pudo guardar el cambio."
            };
        }
        catch (Exception)
        {
            Logger.LogWarning("No se pudo cambiar el estado del panel. Código: control_panel.");
            _errorControl = true;
            _mensajeControl = "No se pudo confirmar el cambio. Revisá el estado del panel antes de reintentar.";
        }
        finally
        {
            _enviandoOrden = false;
        }
    }

    public void Dispose()
    {
        _cerrado = true;
        _suscripcion?.Dispose();
    }
}
