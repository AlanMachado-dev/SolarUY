@page "/cuenta/iniciar-sesion"
@namespace SolarUY.Presentation.Pages
@attribute [AllowAnonymous]

<PageTitle>Iniciar sesión - SolarUY</PageTitle>
<h1>Iniciar sesión</h1>
@if (Error == "credenciales")
{
    <div class="alert alert-danger" role="alert">El usuario o la contraseña no son correctos.</div>
}
<form method="post" action="/cuenta/autenticar" data-enhance="false">
    <AntiforgeryToken />
    <div class="mb-3">
        <label class="form-label" for="usuario">Usuario</label>
        <input class="form-control" id="usuario" name="Nombre" autocomplete="username" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Contraseña</label>
        <input class="form-control" id="password" name="Password" type="password" autocomplete="current-password" required />
    </div>
    <button class="btn btn-primary" type="submit">Iniciar sesión</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
