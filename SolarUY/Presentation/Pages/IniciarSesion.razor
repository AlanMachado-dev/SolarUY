@page "/cuenta/iniciar-sesion"
@namespace SolarUY.Presentation.Pages
@attribute [AllowAnonymous]

<PageTitle>Iniciar sesión - SolarUY</PageTitle>
<h1>Iniciar sesión</h1>
@if (Error == "cancelado")
{
    <div class="alert alert-info" role="status">Se canceló el inicio de sesión. Podés intentarlo nuevamente.</div>
}
else if (Error == "proveedor")
{
    <div class="alert alert-danger" role="alert">No se pudo iniciar sesión. Intentá nuevamente.</div>
}
else if (Error == "cierre")
{
    <div class="alert alert-warning" role="alert">La sesión de SolarUY se cerró, pero no se pudo completar el cierre en el proveedor externo.</div>
}
<p>Ingresá con tu cuenta del proveedor externo. Allí se solicitarán tus credenciales.</p>
<form method="post" action="/cuenta/autenticar" data-enhance="false">
    <AntiforgeryToken />
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <button class="btn btn-primary" type="submit">Iniciar sesión con proveedor externo</button>
</form>
<p class="mt-3">Si el formulario venció, recargá esta página para volver a intentar.</p>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }
}
