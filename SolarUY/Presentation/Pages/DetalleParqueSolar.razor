@page "/parques-solares/{Id:guid}"
@namespace SolarUY.Presentation.Pages
@attribute [Authorize]
@using System.Globalization
@inject IParqueSolarService ParqueService
@inject NavigationManager Navegacion
@inject ILogger<DetalleParqueSolar> Logger

<PageTitle>Detalle del parque solar - SolarUY</PageTitle>
<h1>Detalle del parque solar</h1>

@if (_errorCarga)
{
    <div class="alert alert-danger" role="alert">No se pudo cargar la información. Intentá nuevamente</div>
    <p><a class="btn btn-primary" href="@($"/parques-solares/{Id:D}")" data-enhance-nav="false">Recargar</a></p>
}
else if (_resultado?.Codigo == CodigoConsultaParqueSolar.NoEncontrado)
{
    <p role="status">No se encontró el parque solar</p>
}
else if (_resultado?.Codigo == CodigoConsultaParqueSolar.Exitoso && _resultado.Parque is { } parque)
{
    @if (Creado)
    {
        <div class="alert alert-success" role="status">El parque solar se creó correctamente.</div>
    }
    <dl>
        <dt>Nombre</dt><dd>@parque.Nombre</dd>
        <dt>Ubicación (localidad / dirección)</dt><dd>@parque.Ubicacion</dd>
        <dt>Capacidad total estimada</dt><dd>@parque.CapacidadTotalEstimadaMw.ToString("0.############################", CultureInfo.CurrentCulture) MW</dd>
    </dl>
    <AuthorizeView Roles="Administrador">
        <Authorized>
            <a class="btn btn-primary mb-3" href="@($"/parques-solares/{parque.ID:D}/nodos/nuevo")" data-enhance-nav="false">+ Agregar nodo</a>
        </Authorized>
    </AuthorizeView>
    <section aria-labelledby="nodos-titulo">
        <h2 id="nodos-titulo">Nodos</h2>
        @if (_resultado.Nodos.Count == 0)
        {
            <p>El parque solar todavía no tiene nodos.</p>
        }
        else
        {
            @foreach (var nodo in _resultado.Nodos)
            {
                <article class="card mb-3 nodo-detalle" aria-labelledby="@($"nodo-{nodo.ID:D}")">
                    <div class="card-body">
                        <h3 class="card-title h4" id="@($"nodo-{nodo.ID:D}")">
                            <AuthorizeView Roles="Administrador,Operador">
                                <Authorized>
                                    <a class="stretched-link enlace-nodo" href="@($"/nodos/{nodo.ID:D}")"
                                       aria-label="@($"Ver detalles de {nodo.Nombre}")" data-enhance-nav="false">@nodo.Nombre</a>
                                </Authorized>
                                <NotAuthorized>@nodo.Nombre</NotAuthorized>
                            </AuthorizeView>
                        </h3>
                        <div class="row">
                            <div class="col-12 col-lg-4">
                                <h4 class="h5">Nodo</h4>
                                <dl>
                                    <dt>Nombre</dt><dd>@nodo.Nombre</dd>
                                    <dt>Latitud</dt><dd>@nodo.Latitud.ToString(CultureInfo.CurrentCulture)</dd>
                                    <dt>Longitud</dt><dd>@nodo.Longitud.ToString(CultureInfo.CurrentCulture)</dd>
                                    <dt>Cantidad de paneles</dt><dd>@nodo.CantidadPaneles</dd>
                                </dl>
                            </div>
                            <div class="col-12 col-lg-4">
                                <h4 class="h5">Inversor</h4>
                                <dl>
                                    <dt>Nombre</dt><dd>@nodo.Inversor.Nombre</dd>
                                    <dt>Número de serie</dt><dd>@nodo.Inversor.NumeroSerie</dd>
                                </dl>
                            </div>
                            <div class="col-12 col-lg-4">
                                <h4 class="h5">Sensor</h4>
                                <dl>
                                    <dt>Nombre</dt><dd>@nodo.Inversor.Sensor.Nombre</dd>
                                    <dt>Número de serie</dt><dd>@nodo.Inversor.Sensor.NumeroSerie</dd>
                                    <dt>Endpoint</dt><dd>@(nodo.Inversor.Sensor.Endpoint ?? "Sin endpoint")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </article>
            }
        }
    </section>
}

<a href="/parques-solares" data-enhance-nav="false">Volver al listado</a>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "creado")]
    private bool Creado { get; set; }

    private ResultadoDetalleParqueSolarDto? _resultado;
    private bool _errorCarga;

    protected override async Task OnParametersSetAsync()
    {
        _resultado = null;
        _errorCarga = false;
        try
        {
            _resultado = await ParqueService.ObtenerPorIdAsync(Id);
        }
        catch (Exception)
        {
            Logger.LogWarning("No se pudo cargar el detalle del parque solar. Código: consulta_detalle.");
            _errorCarga = true;
        }

        if (_resultado?.Codigo == CodigoConsultaParqueSolar.AutenticacionRequerida)
        {
            _resultado = null;
            Navegacion.NavigateTo("/cuenta/iniciar-sesion", forceLoad: true);
        }
    }
}
