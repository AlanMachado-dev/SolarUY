@page "/nodos/{Id:guid}"
@namespace SolarUY.Presentation.Pages
@attribute [Authorize(Roles = "Administrador,Operador")]
@using System.Globalization
@using SolarUY.Application.Nodos
@inject INodoService NodoService
@inject NavigationManager Navegacion
@inject ILogger<DetalleNodo> Logger

<PageTitle>Detalle del nodo - SolarUY</PageTitle>
<h1>Detalle del nodo</h1>

@if (_errorCarga)
{
    <div class="alert alert-danger" role="alert">No se pudo cargar la información. Intentá nuevamente</div>
    <p><a class="btn btn-primary" href="@($"/nodos/{Id:D}")" data-enhance-nav="false">Recargar</a></p>
}
else if (_resultado?.Codigo == CodigoConsultaNodo.NoEncontrado)
{
    <p role="status">No se encontró el nodo</p>
    <a href="/parques-solares" data-enhance-nav="false">Volver al listado</a>
}
else if (_resultado?.Codigo == CodigoConsultaNodo.Exitoso && _resultado.Nodo is { } nodo)
{
    @if (PanelRegistrado)
    {
        <div class="alert alert-success" role="status">Panel solar registrado</div>
    }
    <div class="detalle-nodo">
        <section aria-labelledby="nodo-titulo" class="mb-4">
            <h2 id="nodo-titulo">Nodo</h2>
            <dl>
                <dt>Nombre</dt><dd>@nodo.Nombre</dd>
                <dt>Latitud</dt><dd>@nodo.Latitud.ToString(CultureInfo.CurrentCulture)</dd>
                <dt>Longitud</dt><dd>@nodo.Longitud.ToString(CultureInfo.CurrentCulture)</dd>
                <dt>Cantidad de paneles</dt><dd>@nodo.CantidadPaneles</dd>
            </dl>
        </section>
        <section aria-labelledby="inversor-titulo" class="mb-4">
            <h2 id="inversor-titulo">Inversor</h2>
            <dl>
                <dt>Nombre</dt><dd>@nodo.Inversor.Nombre</dd>
                <dt>Número de serie</dt><dd>@nodo.Inversor.NumeroSerie</dd>
            </dl>
        </section>
        <section aria-labelledby="sensor-titulo" class="mb-4">
            <h2 id="sensor-titulo">Sensor</h2>
            <dl>
                <dt>Nombre</dt><dd>@nodo.Inversor.Sensor.Nombre</dd>
                <dt>Número de serie</dt><dd>@nodo.Inversor.Sensor.NumeroSerie</dd>
                <dt>Endpoint</dt><dd>@(nodo.Inversor.Sensor.Endpoint ?? "Sin endpoint asociado")</dd>
            </dl>
        </section>
        <section aria-labelledby="paneles-titulo" class="mb-4">
            <h2 id="paneles-titulo">Paneles solares</h2>
            @if (_resultado.Paneles.Count == 0)
            {
                <p>Este nodo todavía no tiene paneles solares</p>
            }
            else
            {
                @foreach (var panel in _resultado.Paneles)
                {
                    <article class="card mb-3" aria-labelledby="@($"panel-{panel.ID:D}")">
                        <div class="card-body">
                            <h3 class="h4" id="@($"panel-{panel.ID:D}")">@panel.Nombre</h3>
                            <dl>
                                <dt>Modelo</dt><dd>@panel.Modelo</dd>
                                <dt>Potencia nominal</dt><dd>@panel.PotenciaNominalW.ToString(CultureInfo.CurrentCulture) W</dd>
                                <dt>Fecha de instalación</dt><dd>@panel.FechaInstalacion.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.CurrentCulture) UTC</dd>
                                <dt>Estado</dt><dd>@panel.Estado</dd>
                                <dt>Generación actual</dt><dd>@(panel.GeneracionActualW is { } generacion ? $"{generacion.ToString(CultureInfo.CurrentCulture)} W" : "Sin mediciones")</dd>
                                <dt>Último mantenimiento</dt><dd>@(panel.UltimoMantenimiento is { } mantenimiento ? mantenimiento.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.CurrentCulture) + " UTC" : "Sin mantenimientos")</dd>
                            </dl>
                        </div>
                    </article>
                }
            }
        </section>
        <div class="d-flex flex-wrap gap-2 mb-2">
            <a class="btn btn-secondary" href="@($"/parques-solares/{nodo.ParqueId:D}")" data-enhance-nav="false">Volver al parque</a>
            <AuthorizeView Roles="Administrador">
                <a class="btn btn-primary" href="@($"/nodos/{nodo.ID:D}/paneles/nuevo")" data-enhance-nav="false">+ Agregar Panel Solar</a>
            </AuthorizeView>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "panelRegistrado")]
    public bool PanelRegistrado { get; set; }

    private ResultadoDetalleNodoDto? _resultado;
    private bool _errorCarga;

    protected override async Task OnParametersSetAsync()
    {
        _resultado = null;
        _errorCarga = false;
        try
        {
            _resultado = await NodoService.ObtenerPorIdAsync(Id);
        }
        catch (Exception)
        {
            Logger.LogWarning("No se pudo cargar el detalle del nodo. Código: consulta_detalle_nodo.");
            _errorCarga = true;
        }

        if (_resultado?.Codigo == CodigoConsultaNodo.AutenticacionRequerida)
        {
            _resultado = null;
            Navegacion.NavigateTo("/cuenta/iniciar-sesion", forceLoad: true);
        }
        else if (_resultado?.Codigo == CodigoConsultaNodo.AccesoDenegado)
        {
            _resultado = null;
            Navegacion.NavigateTo("/cuenta/acceso-denegado", forceLoad: true);
        }
    }
}
