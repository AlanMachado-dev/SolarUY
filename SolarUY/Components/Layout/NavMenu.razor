<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SolarUY</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView Roles="Administrador">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="parques-solares/nuevo" data-enhance-nav="false">Registrar parque solar</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="px-3 text-white" role="status">
                    <p>Sesión iniciada: @(context.User.Identity?.Name ?? "Usuario autenticado")</p>
                    <p>
                        Roles:
                        @if (context.User.IsInRole("Administrador"))
                        {
                            <span>Administrador </span>
                        }
                        @if (context.User.IsInRole("Operador"))
                        {
                            <span>Operador </span>
                        }
                        @if (!context.User.IsInRole("Administrador") && !context.User.IsInRole("Operador"))
                        {
                            <span>Sin roles reconocidos</span>
                        }
                    </p>
                </div>
                <div class="nav-item px-3">
                    <form method="post" action="/cuenta/cerrar-sesion" data-enhance="false">
                        <AntiforgeryToken />
                        <button class="nav-link btn" type="submit">Cerrar sesión</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="cuenta/iniciar-sesion" data-enhance-nav="false">Iniciar sesión</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
        
    </nav>
</div>

